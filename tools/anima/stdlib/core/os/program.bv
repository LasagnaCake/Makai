using import core.types

module OS {
	struct Program {
		struct Option {
			@ByValue key: string
			@ByValue value: ?any
		}
		
		@ByRef name:	?string
		@ByRef args:	?[string]
		@ByRef config:	?[Option]
		
		info :: () -> Program =>
			new Program {
				name = Program.getName;,
				args = Program.getArgs;,
				config = Program.getConfig;
			}
		
		@Private
		@Static
		@Shared(name = "av2/os/proc/args", optional = true, lib = av2osinfo)
		getArgs :: () -> ?[string]
		
		@Private
		@Static
		@Shared(name = "av2/os/proc/cfg/keys", optional = true, lib = av2osinfo)
		getConfigKeys :: () -> ?[string]
		
		@Private
		@Static
		@Shared(name="av2/os/proc/cfg/value", optional = true, lib = av2osinfo)
		getConfigValue :: (key: string) -> ?any
		
		@Private
		@Static
		@Shared(name = "av2/os/proc/name", optional = true, lib = av2osinfo)
		getName :: () -> ?string
		
		@Private
		@Static
		getConfig :: () -> ?[Setting] {
			@ByRef keys := Program.getConfigKeys;
			if not keys return null
			@ByCopy total := countof keys
			@ByRef out := new Setting[total]
			repeat @ByRef i: uint64 -> total {
				key := copy keys[i - total]
				out[i - total] new Program{key = key, value = Program.getConfigValue(key)}
			}
			return out
		}
	}
	
	env :: () => Program.info()
}