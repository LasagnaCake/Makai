using import core.types

module OS {
	struct Program {
		struct Option {
			@ByValue key: string
			@ByValue value: ?any
		}

		@ByRef name:	?string
		@ByRef args:	?[string]
		@ByRef config:	?[Option]

		@Static
		info :: () -> ?Program =>
			new Program {
				name = Program.getName!,
				args = Program.getArgs!,
				config = Program.getConfig!
			}
			when Program.getConfigKeyCount!
			else null

		@Private
		@Static
		@Shared(name = "av2/proc/getArgCount", optional = true, lib = av2proc)
		getArgCount :: (index: uint64) -> ?uint64

		@Private
		@Static
		@Shared(name = "av2/proc/getArg", optional = true, lib = av2proc)
		getArg :: (index: uint64) -> ?string

		@Private
		@Static
		@Shared(name = "av2/proc/getConfigKeyCount", optional = true, lib = av2proc)
		getConfigKeyCount :: () -> ?uint64

		@Private
		@Static
		@Shared(name = "av2/proc/getConfigKey", optional = true, lib = av2proc)
		getConfigKey :: (index: uint64) -> ?string

		@Private
		@Static
		@Shared(name="av2/proc/getConfigValue", optional = true, lib = av2proc)
		getConfigValue :: (key: string) -> ?any

		@Private
		@Static
		@Shared(name = "av2/proc/getName", optional = true, lib = av2proc)
		getName :: () -> ?string

		@Private
		@Static
		getConfig :: () -> ?[Setting] {
			@ByCopy total := Program.getConfigKeyCount!
			if not total return null
			@ByRef out := new Setting[total]
			repeat @ByRef i: uint64 -> total {
				key := Program.getConfigKey(i - total)
				if copy key {
					@ByRef kx := key ?? ""
					out[i - total] = new Program{key = kx, value = Program.getConfigValue(kx)}
				}
			}
			return out
		}

		@Private
		@Static
		getArgs :: () -> ?[string] {
			@ByCopy total := Program.getArgCount!
			if not total return null
			@ByRef out := new string[total]
			repeat @ByRef i: uint64 -> total {
				arg := Program.getArg(i - total)
				if not copy arg return null
				out[i - total] = arg ?? ""
			}
			return out
		}
	}

	env :: () => Program.info!
}
