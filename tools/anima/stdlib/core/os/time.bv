using import core.types

module OS.Time {
	enum Precision: int64 {
		HOURS = -2
		MINUTES
		SECONDS
		MILLIS
		MICROS
		NANOS

	}
	
	@Shared(name = "av2/time/localNow", lib = av2time)
	localNow :: (precision: Precision) -> int64

	@Shared(name = "av2/time/utcNow", lib = av2time)
	utcNow :: (precision: Precision) -> int64

	@Shared(name = "av2/time/procNow", lib = av2time)
	procNow :: (precision: Precision) -> int64
}