using import core.types

module OS.Shell {
	struct Command {
		name: string
		args: [string]
	}

	@Shared(lib=av2shell, name="av2/shell/cd")
	cd :: (dir: string) -> bool


	@Shared(lib=av2shell, name="av2/shell/rm")
	rm :: (dir: string) -> bool

	@Shared(lib=av2shell, name="av2/shell/cp")
	cp :: (dir: string) -> bool

	@Shared(lib=av2shell, name="av2/shell/mv")
	mv :: (dir: string) -> bool

	@Shared(lib=av2shell, name="av2/shell/exec")
	exec :: (proc: string, args: [string]) -> ?int

	exec :: (cmd: Command) => exec(cmd.name, cmd.args)
}