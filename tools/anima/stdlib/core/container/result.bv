using import core.types

@ExplicitNew
struct Result[Ok, Error]: join (Ok, Error) {
	@New create(value: Ok) => new Self {value}

	@New create(fail: Error) => new Self {fail}

	prop value get (@ByRef self: Self) -> ?Ok => match self {
		is Ok => self.result as Ok
		is Error => null
	}

	prop fail get (@ByRef self: Self) -> ?Error => match self {
		is Error => null
		is Ok => self.result as Error
	}

	prop ok get (self: Self) => self.result is Ok
}