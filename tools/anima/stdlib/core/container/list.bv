using import core.types

using import core.constraints.same
using import core.constraints.comparable
using import core.constraints.iterator
using import core.constraints.opnew

struct List[Element] {
	using Elements = with [Element]

	extend Self {
		struct Iterator {
			@[Private, ByCopy] index: u64
			@[Private, ByRef] elements: Elements

			prop next get (@ByRef self: Self) -> ?Element =>
				if (self.index >= countof self.elements)
					null
				else self.elements[(++self.index)-1]

			@New
			init :: (@ByRef self: Self, elements: Elements) -> Self {
				self.index = 0
				self.elements = elements
				return self
			}
		}

		assert Is.Iterator[Iterator] else "Failed to generate list iterator!"

		prop iterator get (@ByRef self: Self) => new Iterator {self.elements}
	}

	if Is.Comparable[Element] extend Self {
		find :: (@ByRef self: Self, @ByCopy value: Element) -> ?u64 {
			index := 0
			for element => self.elements
				if element == value
					return index
				else ++index
			return null
		}

		rfind :: (@ByRef self: Self, @ByCopy value: Element) -> ?u64 {
			repeat @ByCopy index: u64 => countof self.elements
				if self.elements[index-1] == value
					return index
			return null
		}

		@Private
		bsearch :: (
			@ByRef self: Self,
			@ByRef key: Element,
			@ByCopy index: u64,
			@ByCopy start: u64,
			@ByCopy stop: u64
		) -> ?u64 =>
			if stop <= start
				null
			else match key <=> self.elements[index] {
				{-1} => self.search(key, start + (stop - start) / 2, start, index-1)
				{+1} => self.search(key, start + (stop - start) / 2, index+1, stop)
				else => index
			}

		bsearch :: (@ByRef self: Self, key: Element) -> ?u64 =>
			self.search(key, (countof self.elements) / 2, 0, (countof self.elements) - 1)

		/*
		filtered :: (@ByRef self: Self, @ByRef rule: (Element) -> bool) -> Self {
			values := new Elements
			for element => self.elements
				if rule(element)
					values <| element
			return new Self {values...}
		}

		filter :: (@ByRef self: Self, @ByRef rule: (Element) -> bool) -> Self {
			values := new Elements
			for element => self.elements
				if rule(element)
					values <| element
			self.elements = values
			return self
		}
		*/
		assert true
	}
	
	@New
	init :: (@ByRef self: Self) -> Self {
		self.elements = new Elements
		return self
	}

	@[New, Variadic]
	init :: (@ByRef self: Self, elements: Elements) -> Self {
		self.elements = elements
		return self
	}

	@Operator(infix="[]")
	at :: (@ByRef self: Self, @ByCopy index: u64) -> ?Element =>
		if index < (countof self.elements)
			self.elements[index]
		else null

	@Operator(infix="[]=")
	store :: (@ByRef self: Self, @ByCopy index: u64, value: Element) -> Self {
		if index < (countof self.elements)
			self.elements[index] = value
		return self
	}

	@Variadic
	insert :: (@ByRef self: Self, @ByCopy index: u64, @ByRef value: [Element]) {
		swaps := (countof self.elements) - index
		self.elements <| value
		repeat i => swaps
			self.elements[i-1] swap self.elements[i]
		return self
	}

	sliced :: (@ByRef self: Self, @ByCopy start: i64, @ByCopy stop: i64) -> Self {
		@ByCopy count := countof self.elements
		while start < 0
			start += count
		while stop < 0
			stop += count
		if (
			stop <= start
		or	start >= count
		or	stop >= count
		) return init(new Self)
		count = stop - start
		result = init(new Self)
		repeat i => count
			result <| self.elements[(i-count) + start]
		return result
	}

	@Operator(infix="<|")
	push :: (@ByRef self: Self, value: Element) {
		self.elements <| value
		return self
	}

	@Operator(prefix="|>")
	pop :: (self: Self) => |> self.elements

	if prove assert Is.Same[Element, List[Element.Element]] extend Self {
		flat :: (@ByRef self: Self, sep: Element.Element) {
			out: Element.Element = new Element.Element
			for entry => self.entries {
				out.push(entry)
				out.push(sep)
			}
			out.pop()
			return out
		}
		
		if prove Is.DefaultNew[Element.Element] flat :: (self: Self) => self.flat(new Element.Element {})
	}

	prop size get (self: Self) -> u64 => countof self.elements

	prop top get (@ByRef self: Self) => self.elements[(self.size - 1)]

	@[Private, ByRef] elements: Elements
}