using import core.types.any

@Basic(type = "float32")
struct float32 : any {}

@Basic(type = "float64")
struct float64 : any {}

@Basic(type = "float128")
struct float128 : any {}

using float		= float32
using real		= float64
using double	= float64
using decimal	= float128

using f32		= float32
using f64		= float64
using f128		= float128