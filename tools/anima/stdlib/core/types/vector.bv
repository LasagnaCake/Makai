using import core.types.any

@Basic(type = "vector")
struct vector : any {
	prop x {
		get (self: vector)				=> self[0]
		set (self: vector, val: float)	=> self[0] = val
	}


	prop y {
		get (self: vector)				=> self[1]
		set (self: vector, val: float)	=> self[1] = val
	}


	prop z {
		get (self: vector)				=> self[2]
		set (self: vector, val: float)	=> self[2] = val
	}


	prop w {
		get (self: vector)				=> self[3]
		set (self: vector, val: float)	=> self[3] = val
	}

	/*
	prop get wxyz (@ByRef self: vector) => self[[3,0,1,2]]
	prop get wzyx (@ByRef self: vector) => self[[3,2,1,0]]
	prop get yxwz (@ByRef self: vector) => self[[1,0,3,2]]
	prop get yzwx (@ByRef self: vector) => self[[1,2,3,0]]
	prop get xzyw (@ByRef self: vector) => self[[0,2,1,3]]

	prop get xxxx (@ByRef self: vector) => self[[0,0,0,0]]
	prop get xyxy (@ByRef self: vector) => self[[0,1,0,1]]
	prop get xyzx (@ByRef self: vector) => self[[0,1,2,0]]
	prop get xyzy (@ByRef self: vector) => self[[0,1,2,1]]
	*/

	prop angle2d get (@ByRef self: vector) => self.y atan2 self.x

	prop length get (@ByRef self: vector) => sqrt (self.x pow 2 + self.y pow 2 + self.z pow 2 + self.w pow 2)

	prop normal get (@ByCopy self: vector) => self / self.length

	angle2dTo	:: (@ByRef self: vector, other: vector) => (other - self).angle2d

	normalTo	:: (@ByRef self: vector, other: vector) => (other - self).normal

	@[Static, Direct] RIGHT		:= new vector{+1, 0, 0, 0}
	@[Static, Direct] LEFT		:= new vector{-1, 0, 0, 0}
	@[Static, Direct] UP		:= new vector{0, +1, 0, 0}
	@[Static, Direct] DOWN		:= new vector{0, -1, 0, 0}
	@[Static, Direct] FORWAR	:= new vector{0, 0, +1, 0}
	@[Static, Direct] BACK		:= new vector{0, 0, -1, 0}
	@[Static, Direct] FUTURE	:= new vector{0, 0, 0, +1}
	@[Static, Direct] PAST		:= new vector{0, 0, 0, -1}
}