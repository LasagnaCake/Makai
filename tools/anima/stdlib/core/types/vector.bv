	prop get yzwx (self: vector) => self[1,2,3,0]
	prop get xzyw (self: vector) => self[0,2,1,3]

	prop get xxxx (self: vector) => self[0,0,0,0]
	prop get xyxy (self: vector) => self[0,1,0,1]
	prop get xyzx (self: vector) => self[0,1,2,0]
	prop get xyzy (self: vector) => self[0,1,2,1]

	prop get angle2d (@ByRef self: vector) => self.y atan2 self.x
	prop get angle3d (@ByRef self: vector) => new vector{self.angle2d, self.yzwx.angle2d, self.xzyw.angle2d, 0}

	prop get len2d (@ByRef self: vector) => sqrt (self.x pow 2 + self.y pow 2)
	prop get len3d (@ByRef self: vector) => sqrt (self.x pow 2 + self.y pow 2 + self.z pow 2)
	prop get len4d (@ByRef self: vector) => sqrt (self.x pow 2 + self.y pow 2 + self.z pow 2 + self.w pow 2)

	prop get normal2d (@ByCopy self: vector) => self / self.len2d
	prop get normal3d (@ByCopy self: vector) => self / self.len3d
	prop get normal4d (@ByCopy self: vector) => self / self.len4d

	prop get normal (@ByRef self: vector) => self.normal4d

	angle2dTo	:: (@ByRef self: vector, other: vector) => (other - self).angle2d
	normal2dTo	:: (@ByRef self: vector, other: vector) => (other - self).normal2d

	angle3dTo	:: (@ByRef self: vector, other: vector) => (other - self).angle3d
	normal3dTo	:: (@ByRef self: vector, other: vector) => (other - self).normal3d

