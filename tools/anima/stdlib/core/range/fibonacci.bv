using import core.types

using import core.constraints

with module Range

module Iterators {
	struct Fibonacci[T: Is.Number] {
		@ByCopy prev: T
		@ByCopy now: T

		prop next get(@ByRef self: Self) -> ?T {
			@ByCopy current := self.now
			self.now += self.prev
			self.prev = current
			return current
		}
	}
}
 
fibonacci :: [T] () => new Iterators.Fibonacci [T] {0, 1}