using import core.types

using import core.meta.spoof

using import core.constraints.same

with module Is

@Direct Callable[T, Args...] := prove {
	Meta.spoof[T]!(Meta.spoof[Args]!...)
}

@Direct Function[T, Return, Args...] := prove {
	if Same[Return, void]
		assert Callable[T, Args...]
	else (Meta.spoof[T]!(Meta.spoof[Args]!...)) as Return
}