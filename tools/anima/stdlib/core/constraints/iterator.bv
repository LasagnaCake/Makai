using import core.types

with module Is.Iterator

@Direct Forward[T] := prove {
	@ByRef t := new T
	try elem => t.next {}
}

@Direct Reverse[T] := prove {
	@ByRef t := new T
	try elem => t.previous {}
}

@Direct Bidirectional[T] := Forward[T] and Reverse[T]

@Direct Foreach[T] := Forward[T] or Reverse[T] or prove {
	@ByRef t := new T
	try elem => t() {}
}

@Direct Iteratable[T] := prove {
	for elem => (new T) {}
}