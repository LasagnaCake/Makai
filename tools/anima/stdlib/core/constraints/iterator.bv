using import core.types

module Iterator {
	@Direct Forward[T] := prove {
		@ByRef t := new T
		try elem => t.next {}
	}

	@Direct Reverse[T] := prove {
		@ByRef t := new T
		try elem => t.previous {}
	}

	@Direct Bidirectional[T] := ForwardIterator[T] and ReverseIterator[T]

	@Direct Foreach[T] := ForwardIterator[T] or ReverseIterator[T] or prove {
		@ByRef t := new T
		try elem => t() {}
	}

	@Direct Iteratable[T] := prove {
		for elem => (new T) {}
	}
}