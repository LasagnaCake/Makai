using import core.types

using import core.meta.spoof

with module Is

kind Forward[T] => prove {
	try elem := Meta.spoof[T]!.next {}
}

kind Reverse[T] => prove {
	try elem := Meta.spoof[T]!.previous {}
}

kind Bidirectional[T] => Forward[T] and Reverse[T]

kind Iterator[T] => Forward[T] or Reverse[T] or prove {
	try elem := Meta.spoof[T]!() {}
}

kind Iteratable[T] => prove {Meta.spoof[T]!.iterator} or prove {for elem => meta.spoof[T]! {}}
