using import core.types

using import core.meta.spoof

with module Is.Op

kind Add[A, B = A] => prove with (a: A, b: B) a + b

kind Sub[A, B = A] => prove with (a: A, b: B) a - b

kind Mul[A, B = A] => prove with (a: A, b: B) a * b

kind Div[A, B = A] => prove with (a: A, b: B) a / b

kind Mod[A, B = A] => prove with (a: A, b: B) a % b

kind ASM[A, B = A] => Add[A, B] and Sub[A, B] and Mul[A, B]

kind Arithmetic[A, B = A] => ASM[A, B] and Div[A, B]