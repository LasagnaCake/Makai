using import core.types

using import core.constraints.basic

with module Convert

if false {
	trait ToString {
		toString :: (self: Self) -> string
	}

	extend string with ToString {
		toString :: (self: Self) => self
	}

	extend [T: Is.Basic] T with ToString {
		assert Is.Not[T, void]

		toString :: (self: Self) => if Is.Not[T, string] $"{self}" else self
	}
}