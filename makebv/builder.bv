using import core

extend struct Builder {
	struct Target {
		@ByRef name: string
		@ByRef flags: Flags
	}

	using Flags = [string]

	@ByRef compiler: string
	@ByRef fileType: string
	@ByRef linker: string
	@ByRef flags: Flags
} {
	compile :: (@ByRef self: Self, @ByRef target: Target, @ByRef file: string, @ByRef folder: string, flags: ?Flags) -> ?int {
		ff : Flags = (flags ?? new Flags) + self.flags + target.flags
		name := (copy folder)/'/'/'.'
		dir := "src/" + dir
		out := "obj/" + target.name
		args = ["-c", dir + "/" + file, "-o", out + "/" + name + "." + file + "." + target.name + ".o"]
		return OS.exec(self.compiler, args)
	}

	build :: (@ByRef self: Self, @ByRef target: Target, @ByRef folder: string, flags: ?Flags) -> ?int {
		ff : Flags = (flags ?? new Flags) + self.flags + target.flags
		name := (copy folder)/'/'/'.'
		dir := "src/" + folder
		out := "obj/" + target.name
		-args = [dir + "/" + file, "-o", out + name + "." + file + "." + target.name + ".o"]
		return OS.exec(self.compiler, args)
	}

	clean :: (target: Target, path: string) -> Self {
		folder := "src/" + path
		for sub => OS.list(folder)
			if not sub.folder and (sub.name & ("." + self.fileType)) and (sub.name & ".o")
				OS.rm(sub.path)
		return self
	}

	doFolder :: (@ByRef self: Self, @ByRef target: Target, @ByRef folder: string, flags: ?Flags) -> [?int] {
		procs := new [?int]
		dir := "src/" + folder
		for sub => OS.list(folder)
			if sub.folder
				procs += self
					.clean(target, sub.path)
					.doFolder(target, folder + "/" + sub.name, flags)
			else if (sub.name & ("." + self.fileType)) and not (sub.name & ".o")
				procs <| self.compile(target, folder, sub.name, flags)
		return procs
	}
}

extend struct Toolchain {
	@ByRef builder: Builder
	@ByRef target: Builder.Target
} {
	@Static
	create(@ByRef lang: string, compiler: string, @ByRef flags: [string]) -> ?Self {
		@ByRef tc := new Toolchain
		lang = (copy lang)/'\\+'/'p'
		match (compiler) {
			"gcc"			=> tc.builder = new Builder {"gcc", lang, flags}
			"clang"			=> tc.builder = new Builder {"clang", lang, flags}
			"mingw-win"		=> tc.builder = new Builder {"mingw32-gcc", lang, flags}
			"mingw-linux"	=> tc.builder = new Builder {"x86_64-mingw32-gcc", lang, flags}
			else => return null
		}
		return tc
	}
}
