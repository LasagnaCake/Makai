using import core

isEven :: (@ByCopy val: uint64) {
	IO.write(val as any)
	if val % 2 IO.writeLine(" Is odd!") else IO.writeLine(" Is even!")
}

isEven2 :: (@ByCopy val: uint64) {
	IO.write(val as any);
	IO.writeLine(" Is odd!" when val % 2 else " Is even!")
}

@Main
main :: () {
	@ByCopy val: uint64 = 0
	IO.writeLine("Testing loop construct 1...")
	while val < 10
		isEven(val++)
	IO.writeLine("Testing loop construct 2...")
	repeat 10
		isEven(val++)
	IO.writeLine("Testing loop construct 3...")
	do
		isEven(val++)
	while val < 30
	val = 0
	IO.writeLine("Testing loop construct 1...")
	while val < 10
		isEven2(val++)
	IO.writeLine("Testing loop construct 2...")
	repeat 10
		isEven2(val++)
	IO.writeLine("Testing loop construct 3...")
	do
		isEven2(val++)
	while val < 30
}
