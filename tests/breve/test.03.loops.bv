using import core

isEven :: (val: uint64) => if val % 2 IO.writeLine("Is odd!") else IO.writeLine("Is even!")

isEven2 :: (val: uint64) => IO.writeLine("Is odd!" if val % 2 else "Is even!")

@Main
main :: () {
	val: uint64 = 0
	while (copy val) < 10
		isEven((ref val)++)
	repeat 10
		isEven((ref val)++)
	do
		isEven((ref val)++)
	while (copy val) < 30
	val = 0
	while (copy val) < 10
		isEven2((ref val)++)
	repeat 10
		isEven2((ref val)++)
	do
		isEven2((ref val)++)
	while (copy val) < 30
}
