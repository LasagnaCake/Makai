using import core

enum Weekday: uint8 {
	MONDAY = 1
	TUESDAY
	WEDNESDAY
	THURSDAY
	FRIDAY
	SATURDAY
	SUNDAY
	
	fullName :: (self: Weekday) =>
		switch self {
			Weekday.MONDAY		=>	"Monday"
			Weekday.TUESDAY		=>	"Tuesday"
			Weekday.WEDNESDAY	=>	"Wednesday"
			Weekday.THURSDAY	=>	"Thursday"
			Weekday.FRIDAY		=>	"Friday"
			Weekday.SATURDAY	=>	"Saturday"
			Weekday.SUNDAY		=>	"Sunday"
			else				=>	"INVALID_DAY"
		}
	
	shortName :: (self: Weekday) =>
		match {
			self == Weekday.MONDAY		=>	"Mon"
			self == Weekday.TUESDAY		=>	"Tue"
			self == Weekday.WEDNESDAY	=>	"Wed"
			self == Weekday.THURSDAY	=>	"Thu"
			self == Weekday.FRIDAY		=>	"Fri"
			self == Weekday.SATURDAY	=>	"Sat"
			self == Weekday.SUNDAY		=>	"Sun"
			else						=>	"INVALID_DAY"
		}
	
	display :: (@ByRef self: Weekday) =>
		IO.writeLine(self.fullName; + " (" + self.shortName; + ")")
}

@Main
main :: () {
	// Full mode
	day := Weekday.MONDAY
	day.display;
	day = Weekday.TUESDAY
	day.display;
	day = Weekday.WEDNESDAY
	day.display;
	day = Weekday.THURSDAY
	day.display;
	day = Weekday.FRIDAY
	day.display;
	day = Weekday.SATURDAY
	day.display;
	day = Weekday.SUNDAY
	day.display;
}
