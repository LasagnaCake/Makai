using import core

enum Weekday: uint8 {
	MONDAY = 1
	TUESDAY
	WEDNESDAY
	THURSDAY
	FRIDAY
	SATURDAY
	SUNDAY
	
	fullName :: (@ByCopy self: Weekday) -> string {
		if self == Weekday.MONDAY			return "Monday"
		else if self == Weekday.TUESDAY		return "Tuesday"
		else if self == Weekday.WEDNESDAY	return "Wednesday"
		else if self == Weekday.THURSDAY	return "Thursday"
		else if self == Weekday.FRIDAY		return "Friday"
		else if self == Weekday.SATURDAY	return "Saturday"
		else if self == Weekday.SUNDAY		return "Sunday"
		else return "INVALID_DAY"
	}
	
	shortName :: (@ByCopy self: Weekday) -> string {
		if self == Weekday.MONDAY			return "Mon"
		else if self == Weekday.TUESDAY		return "Tue"
		else if self == Weekday.WEDNESDAY	return "Wed"
		else if self == Weekday.THURSDAY	return "Thu"
		else if self == Weekday.FRIDAY		return "Fri"
		else if self == Weekday.SATURDAY	return "Sat"
		else if self == Weekday.SUNDAY		return "Sun"
		else return "INVALID_DAY"
	}
	
	display :: (@ByCopy self: Weekday)
		=> IO.writeLine(self.fullName; + " (" + self.shortName; + ")")
}

@Main
main :: () {
	// Full mode
	day := Weekday.MONDAY
	day.display;
	day = Weekday.TUESDAY
	day.display;
	day = Weekday.WEDNESDAY
	day.display;
	day = Weekday.THURSDAY
	day.display;
	day = Weekday.FRIDAY
	day.display;
	day = Weekday.SATURDAY
	day.display;
	day = Weekday.SUNDAY
	day.display;
	// Shorthand mode
	Weekday.MONDAY.display;
	Weekday.TUESDAY.display;
	Weekday.WEDNESDAY.display;
	Weekday.THURSDAY.display;
	Weekday.FRIDAY.display;
	Weekday.SATURDAY.display;
	Weekday.SUNDAY.display;
} 