using import core

enum Weekday: uint8 {
	MONDAY = 1
	TUESDAY
	WEDNESDAY
	THURSDAY
	FRIDAY
	SATURDAY
	SUNDAY
	
	fullName :: (@ByCopy self: Weekday) =>
		if self == Weekday.MONDAY			"Monday"
		else if self == Weekday.TUESDAY		"Tuesday"
		else if self == Weekday.WEDNESDAY	"Wednesday"
		else if self == Weekday.THURSDAY	"Thursday"
		else if self == Weekday.FRIDAY		"Friday"
		else if self == Weekday.SATURDAY	"Saturday"
		else if self == Weekday.SUNDAY		"Sunday"
		else "INVALID_DAY"
	
	shortName :: (@ByCopy self: Weekday) =>
		if self == Weekday.MONDAY			"Mon"
		else if self == Weekday.TUESDAY		"Tue"
		else if self == Weekday.WEDNESDAY	"Wed"
		else if self == Weekday.THURSDAY	"Thu"
		else if self == Weekday.FRIDAY		"Fri"
		else if self == Weekday.SATURDAY	"Sat"
		else if self == Weekday.SUNDAY		"Sun"
		else "INVALID_DAY"
	
	display :: (@ByCopy self: Weekday) =>
		IO.writeLine(self.fullName; + " (" + self.shortName; + ")")
}

@Main
main :: () {
	// Full mode
	day := Weekday.MONDAY
	day.display;
	day = Weekday.TUESDAY
	day.display;
	day = Weekday.WEDNESDAY
	day.display;
	day = Weekday.THURSDAY
	day.display;
	day = Weekday.FRIDAY
	day.display;
	day = Weekday.SATURDAY
	day.display;
	day = Weekday.SUNDAY
	day.display;
} 