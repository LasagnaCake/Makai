using import core

@Main
main :: () {
	IO.writeLine("Doing 100 million loops...")
	start := OS.Time.localNow(OS.Time.Precision.NANOS)
	IO.writeLine("Loop iteration #0")
	repeat @ByCopy i: uint64 -> 100_000 {
		unless likely i % 100_000 {
			IO.write("Loop iteration #")
			IO.writeLine((i * 100_000) as any)
		}
	}
	stop := OS.Time.localNow(OS.Time.Precision.NANOS)
	IO.write("Result: ")
	IO.write(((stop - start) / 100.0) as any)
	IO.writeLine("ms")
}
