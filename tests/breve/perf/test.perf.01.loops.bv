using import core

@Main
main :: () {
	IO.writeLine("Doing 100 million loops...")
	start := OS.Time.localNow(OS.Time.Precision.MILLIS)
	IO.writeLine("Loop iteration #0");
	repeat @ByCopy i: uint64 -> 100_000_000 {
		unless likely (i % 100) {
			IO.write("Loop iteration #")
			IO.writeLine((i * 100) as any);
		}
	}
	stop := OS.Time.localNow(OS.Time.Precision.MILLIS)
	IO.write("Result: ")
	IO.write((stop - start) as any)
	IO.writeLine("ms")
}
