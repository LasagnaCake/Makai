using import core

@Main
main :: () {
	@Direct count := (10 pow 3) as uint64
	IO.writeLine("Doing 100 million loops...")
	start := OS.Time.localNow(OS.Time.Precision.NANOS)
	IO.writeLine("Loop iteration #0")
	repeat @ByCopy i: uint64 => count {
		@ByCopy it := ((count-i+1) % (count/10))
		IO.writeLine(it as any)
		unless unlikely it {
			IO.write("Loop iteration #")
			IO.writeLine((count-i) as any)
		}
	}
	total := ((OS.Time.localNow(OS.Time.Precision.NANOS) - start) / (10 pow 9.0))
	IO.write("\nResult::{\n  total-time: ")
	IO.writeLine(total as any)
	IO.writeLine("}")
}