using import core

module Test.Namespace {
	@Nullable
	struct MySpecialStruct {
		@ByCopy example : int64 = 0
	}

	foo :: (@ByCopy var: int64) -> int64 {
		return var + var
	}

	bar :: (@ByCopy var: int64) -> int64 => (foo(var) * var)

	baz :: (@ByCopy var: int64) => (bar(var) - var)

	biff :: () -> void
	
	printToOutput :: () => IO.writeLine("Beginning calculations...")
}

@Main
main :: () {
    IO.writeLine("We are calculating!")
    Test.Namespace.printToOutput()
    val := 32 + 64
    IO.write("32 + 64 = ")
    IO.writeLine(val as any)
    val = Test.Namespace.baz(32 + 64)
    IO.write("baz(32 + 64) = ")
    IO.writeLine(val as any)
    val = 32 - 64
    IO.write("32 - 64 = ")
    IO.writeLine(val as any)
    val = Test.Namespace.baz(32 - 64)
    IO.write("baz(32 - 64) = ")
    IO.writeLine(val as any)
}
