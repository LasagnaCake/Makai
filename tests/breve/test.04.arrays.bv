using import core

printArray :: (@ByRef arr: [uint64]) {
	@ByCopy sz := countof arr
	repeat @ByRef i : uint64 -> sz
		IO.writeLine(arr[sz - i] as any)
}

@Main
main :: () {
	@ByRef val := new [uint64]
	repeat @ByRef i : uint64 -> 32
		val[i] = 32 - i
	printArray(val)
	@ByCopy sz := countof val
	repeat @ByRef i : uint64 -> sz
		val[i] = val[sz - i]
	printArray(val)
}
