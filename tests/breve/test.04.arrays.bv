using import core

printArray :: (@ByRef arr: [uint64]) {
	IO.writeLine("Printing array...")
	@ByCopy sz := countof arr
	IO.write("Size: ")
	IO.writeLine(sz as any)
	repeat @ByRef i : uint64 -> sz {
		@ByCopy at := sz - i
		IO.write("Index [")
		IO.write(at as any)
		IO.write("] = ")
		IO.writeLine((copy arr[at]) as any)
	}
	IO.writeLine("Done!")
}

@Main
main :: () {
	@ByRef val := new uint64[32]
	IO.writeLine("Creating array...")
	@ByCopy sz := countof val
	IO.write("Size: ")
	IO.writeLine(sz as any)
	repeat @ByCopy i : uint64 -> sz
		val[sz - i] = i
	IO.writeLine("Done creating!")
	printArray(val)
	IO.writeLine("Modifying array...")
	repeat @ByCopy i : uint64 -> sz
		val[i - 1] = (copy val[i - 1]) + val[sz - i]
	IO.writeLine("Done modifying!")
	printArray(val)
}
