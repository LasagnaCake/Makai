using import core

printArray(arr: [int64]) =>
	repeat @ByRef i : uint64 -> countof array
		IO.writeLine(arr[32 - i])

@Main
main :: () {
	@ByRef val : [uint64]
	repeat @ByRef i : uint64 -> 32
		val[i] = 32 - i
	printArray(val)
	@ByCopy sz := countof array
	repeat @ByRef i : uint64 -> sz
		val[i] = val[sz - i]
	printArray(val)
}
