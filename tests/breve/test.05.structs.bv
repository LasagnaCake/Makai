using import core

struct Person {
	@ByCopy firstName : string
	@ByCopy lastName : string
	
	fullName :: (@ByRef self: Person) => '"' + self.firstName + " " + self.lastName + '"'
	
	@Static
	create :: (firstName: string, lastName: string = "Someone") => new Person {firstName, lastName}
}

@Main
main :: () {
	@ByRef foo := new Person {
		firstName	= "John",
		lastName	= "Doe"
	}
	IO.writeLine("Hello, " + foo.fullName; + "!")
	foo.lastName = "Lastname"
	IO.writeLine("Hello, " + foo.fullName; + "!")
	foo.firstName = "Firstname"
	IO.writeLine("Hello, " + foo.fullName; + "!")
	foo = Person.create("Iam")
	IO.writeLine("Hello, " + foo.fullName; + "!")
} 