using import core

isEven :: (val: uint64) => if val % 2 IO.writeLine("Is odd!") else IO.writeLine("Is even!")

isEven2 :: (val: uint64) => IO.writeLine("Is odd!" when val % 2 else "Is even!")

@Main
main :: () {
	@ByRef val: uint64 = 0
	isEven(val++)
	isEven(val++)
	isEven(val++)
	isEven(val++)
	isEven(val++)
	isEven(val++)
	isEven(val++)
	isEven(val++)
	isEven(val++)
	isEven(val++)
	isEven2(val++)
	isEven2(val++)
	isEven2(val++)
	isEven2(val++)
	isEven2(val++)
	isEven2(val++)
	isEven2(val++)
	isEven2(val++)
	isEven2(val++)
	isEven2(val++)
}
